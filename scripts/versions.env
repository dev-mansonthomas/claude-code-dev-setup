# versions.env — shared version pins, sourced by scripts/vm-provision.sh and scripts/30-mcp.sh.
# Single source of truth so the Playwright MCP and the browser revisions installed for it can
# never drift apart (the "Executable doesn't exist" failure). Not a script — just KEY=value.
#
# Playwright MCP (@playwright/mcp). Its releases pin an *alpha* Playwright build (there is no
# stable-Playwright MCP release), so vm-provision.sh installs that EXACT Playwright globally + its
# browsers, and 30-mcp.sh registers this same MCP version. The global `playwright` CLI and the MCP
# therefore share one version ⇒ one set of cached browsers.
# To bump: `npm view @playwright/mcp versions` → set here → re-run ./03-vm-up.sh (reinstalls browsers).
PW_MCP_VERSION="0.0.81"
