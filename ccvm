#!/usr/bin/env bash
# ccvm — work inside the always-on Colima VM (the default isolated environment).
#   ccvm <project>                 open VS Code on the host project + a Claude session INSIDE the VM
#   ccvm <project> [claude-args…]  same, forwarding extra flags to `claude` (conservative charset only)
#                                  — e.g. `ccvm <project> --worktree <stream>` for a parallel
#                                  workstream in an isolated git worktree (docs/parallel-workstreams.md)
#   ccvm                           shell into the VM (at ~/Projects)
#   ccvm -h | --help               full help: arguments, environment variables, consequences,
#                                  and how to create a new project (./05-new-project.sh)
# You edit on the host (files are mounted into the VM); Claude + Docker + tests run in the VM.
set -euo pipefail
PROJECTS="$HOME/Projects"
has(){ command -v "$1" >/dev/null 2>&1; }
# A switch is ON when set to anything but empty or 0 (so CCVM_SAFE=0 really means "off").
on(){ [[ -n "${1:-}" && "${1:-}" != 0 ]]; }

usage() {
  cat <<'EOF'
ccvm - work inside the always-on Colima VM (the default isolated environment).
You edit on the Mac (~/Projects is mounted into the VM); Claude Code, Docker and tests run in the VM.

USAGE
  ccvm                             Open a login shell in the VM, at ~/Projects.
  ccvm <project> [claude-args...]  Open VS Code on the Mac at the project, then start Claude Code
                                   INSIDE the VM in that project, with claude-args forwarded.
  ccvm -h | --help                 This help. Only as the FIRST argument: `ccvm <project> --help`
                                   forwards --help to claude instead.

NEW PROJECT
  ccvm opens existing projects; it does not create one. Create it on the Mac, from the kit folder:
    cd ~/Projects/claude-code-dev-setup && ./05-new-project.sh my-app
  That creates ~/Projects/my-app from project-template/ (CLAUDE.md, docs/, .gitignore, secret-scan
  hook, .worktreeinclude), fills in the name, runs `git init` and stages the files (no commit),
  then launches `ccvm my-app` for you.
  - The default destination is ../<name> relative to the CURRENT folder, so run it from the kit
    folder. Elsewhere, pass the target: ./05-new-project.sh my-app ~/Projects/my-app. A project
    outside ~/Projects is created but not opened (the VM can't see it).
  - Names: letters, digits, . _ - only. It refuses to overwrite an existing folder.
  - Options: --redis (add the Redis MCP to the project), --no-mcp (don't ask), --no-launch (just
    create it; open it later with `ccvm my-app`). REDIS_URL=... sets the Redis connection string.
  - First time on this Mac? Run ./03-vm-up.sh once (the VM) and ./04-vm-auth.sh (the token) first.
  - Existing repo instead? Clone it under ~/Projects, then `ccvm <name>`.

<project>
  A name under ~/Projects (e.g. `ccvm my-app` -> ~/Projects/my-app) or a path to a directory.
  It must be under ~/Projects: only that folder is mounted in the VM (same path inside), so
  anything else is refused (exit 1).

[claude-args...]
  Forwarded to `claude` after the permission flag, e.g.
    ccvm my-app --worktree gps-live     parallel work stream in an isolated git worktree,
                                        on branch worktree-gps-live (docs/parallel-workstreams.md)
    ccvm my-app --model opus            pick the model for this session
  Only the characters A-Z a-z 0-9 . _ / = - are accepted, so a value can never break out of the
  remote shell command: `--model "x y"` or anything with spaces/quotes/$ is refused (exit 2).
  Use the form --flag=value or separate words, without spaces inside a value.

WHAT A SESSION DOES
  1. Checks Colima is installed and running (otherwise exit 1: run ./03-vm-up.sh).
  2. Opens VS Code on the Mac at the project (skipped with a notice if `code` is not on PATH).
  3. Moves your Claude Code OAuth token into the VM over stdin, never on a command line, into a
     tmpfs file readable only by you; the session loads it and deletes the file before Claude
     starts. No token -> Claude asks you to log in inside the VM.
  4. Starts `claude --permission-mode auto` in the project, inside the VM.

PERMISSION MODE (who approves what Claude does)
  default (no variable)  auto: Claude runs commands and applies edits itself; a built-in safety
                         classifier blocks destructive actions (rm -rf, git reset --hard,
                         force-push, terraform destroy, ...). The VM is the security boundary.
  CCVM_SAFE=1            acceptEdits: edits are applied automatically, but shell commands outside
                         the VM allow-list (claude-config/settings.vm.json) ask for your approval.
                         Slower, more control.
  CCVM_YOLO=1            --dangerously-skip-permissions: no approvals and no classifier at all.
                         DISABLED by org policy on Enterprise accounts (e.g. Redis): there it has no
                         effect beyond the policy's own fallback. Use only where policy allows it,
                         and only in a VM you can throw away.
  CCVM_YOLO wins over CCVM_SAFE. A value of 0 or empty means off.

ENVIRONMENT VARIABLES
  CCVM_SAFE                default: off
      Consequences: switches the session to acceptEdits (see above): commands outside the allow-list
      wait for your approval instead of going through the safety classifier.
  CCVM_YOLO                default: off
      Consequences: requests --dangerously-skip-permissions (see above). Removes every guard where
      allowed; a no-op on accounts whose policy disables it.
  CLAUDE_CODE_OAUTH_TOKEN  default: unset
      Consequences: the token to inject for this session, taking precedence over CC_TOKEN_FILE.
      Prefer the file: a variable set inline lands in your shell history.
  CC_TOKEN_FILE            default: ~/.config/claude-code-dev-setup/oauth-token
      Consequences: where the long-lived token is read from (on the Mac only; it is never copied
      into ~/Projects or the VM image). Created by ./04-vm-auth.sh (`claude setup-token`). If the
      file is missing or unreadable, Claude prompts for a login inside the VM.

EXIT STATUS
  1  Colima missing or not running, project not found, or project outside ~/Projects.
  2  A forwarded argument contains a character outside the allowed set.
  Otherwise the exit status of the VM shell / Claude session.

EXAMPLES
  cd ~/Projects/claude-code-dev-setup && ./05-new-project.sh my-app
                                     create ~/Projects/my-app, then open it with ccvm
  ccvm my-app                        Claude in auto mode on ~/Projects/my-app
  CCVM_SAFE=1 ccvm my-app            same, approving every command
  ccvm my-app --worktree sinistres   a second, isolated work stream (one terminal per stream)
  ccvm                               just a shell in the VM

SEE ALSO
  ./03-vm-up.sh --help   bring up / re-provision the VM
  ./04-vm-auth.sh        create the token used above
  docs/isolation.md, docs/parallel-workstreams.md
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

has colima || { echo "Colima not installed — run ./03-vm-up.sh first." >&2; exit 1; }
colima status >/dev/null 2>&1 || { echo "Colima VM not running — start it with ./03-vm-up.sh (or: colima start)." >&2; exit 1; }

# Auth: inject a long-lived OAuth token into the VM session if you've set one up.
# Generate it on the HOST (which has a browser) with `claude setup-token`, then save it to
# the file below. It's read from the host only and passed per-session — never written into
# the VM image or under ~/Projects, so it can't be committed. Absent → log in inside the VM.
TOKEN_FILE="${CC_TOKEN_FILE:-$HOME/.config/claude-code-dev-setup/oauth-token}"
tok="${CLAUDE_CODE_OAUTH_TOKEN:-}"
if [[ -z "$tok" && -r "$TOKEN_FILE" ]]; then tok="$(tr -d '[:space:]' < "$TOKEN_FILE")"; fi

# Move the token into the VM over STDIN — never on a command line — so it can't be read from `ps` /
# /proc/<pid>/cmdline on the host or in the VM. It lands in a tmpfs file (600); the launch command
# loads it into the session env and shreds the file before Claude starts. No token → login prompt.
VM_TOKFILE="/dev/shm/.ccvm-oauth-token"
inject_token() { [ -n "$tok" ] || return 0; printf '%s' "$tok" | colima ssh -- sh -c "umask 077; cat > '$VM_TOKFILE'" >/dev/null 2>&1 || true; }
# shellcheck disable=SC2016  # the $(cat …) must stay literal — it's evaluated remotely in the VM
tok_prelude()  { [ -n "$tok" ] || return 0; printf 'export CLAUDE_CODE_OAUTH_TOKEN="$(cat %s 2>/dev/null)"; rm -f %s; ' "$VM_TOKFILE" "$VM_TOKFILE"; }

# No arg → just drop into the VM.
if [[ $# -eq 0 ]]; then
  inject_token
  exec colima ssh -- bash -lc "$(tok_prelude)cd '$PROJECTS' 2>/dev/null || true; exec \"\$(command -v zsh || echo bash)\" -l"
fi

# Resolve <project> to an absolute host path under ~/Projects (mounted at the same path in the VM).
name="$1"; shift   # remaining args (if any) are forwarded to `claude` below
if [[ -d "$name" ]]; then abs="$(cd "$name" && pwd)"; else abs="$PROJECTS/$name"; fi
[[ -d "$abs" ]] || { echo "Project not found: $abs" >&2; exit 1; }
case "$abs" in
  "$PROJECTS"|"$PROJECTS"/*) ;;
  *) echo "⚠ $abs is outside $PROJECTS — it isn't mounted in the VM. Put projects under $PROJECTS." >&2; exit 1 ;;
esac

# Open the editor on the host (edits the mounted files).
if has code; then
  code "$abs" >/dev/null 2>&1 || true
else
  echo "(VS Code 'code' not on PATH — skipping editor; install: brew install --cask visual-studio-code)" >&2
fi

# Enter the VM at the project and launch Claude there. We start in "auto" mode via the CLI FLAG:
# Claude auto-runs commands AND auto-applies edits, gated by a built-in safety classifier that
# blocks destructive ops (rm -rf, git reset --hard, terraform destroy, …). This is the autonomous
# mode that actually works on managed accounts: acceptEdits only covers edits (and its mode wasn't
# reliably engaged here), and bypassPermissions is DISABLED by org policy on Enterprise (e.g. Redis)
# accounts — so --dangerously-skip-permissions is a no-op for us. Escape hatches: CCVM_SAFE=1 →
# acceptEdits (edits-only autonomy); CCVM_YOLO=1 → request bypass (only effective where policy allows).
echo "→ entering VM at $abs  (Claude Code runs inside the VM; edit on the host)"
flags=" --permission-mode auto"
if on "${CCVM_YOLO:-}"; then flags=" --dangerously-skip-permissions"
elif on "${CCVM_SAFE:-}"; then flags=" --permission-mode acceptEdits"; fi
# Forward any extra args to `claude` (e.g. `--worktree <stream>` for a parallel workstream). Restrict
# to a conservative charset so a forwarded value can't break out of the remote `bash -lc` command.
for a in "$@"; do
  case "$a" in
    *[!A-Za-z0-9._/=-]*) echo "⚠ refusing to forward unsafe arg to claude (allowed chars: A-Za-z0-9 . _ / = -): $a" >&2; exit 2 ;;
  esac
  flags="$flags $a"
done
inject_token
exec colima ssh -- bash -lc "$(tok_prelude)cd '$abs' && exec claude$flags"
